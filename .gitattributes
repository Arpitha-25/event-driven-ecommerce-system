# Normalise line endings in the repository; check out with the platform default.
* text=auto

# Files run inside Linux containers or by Unix shells must keep LF.
mvnw text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf

# Windows scripts keep CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.pdf binary
*.jar binary
